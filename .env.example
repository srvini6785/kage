NODE_ENV=development
PORT=3040
PUBLIC_ORIGIN=http://localhost:3040
# Opcional: permissões do convite (padrão mínimo curado; nunca use Administrator).
INVITE_PERMISSIONS=
# Crie uma aplicação própria no Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3040/auth/callback
# Servidor de desenvolvimento para registrar os slash commands.
DISCORD_GUILD_ID=
MONGO_URI=mongodb://127.0.0.1:27017/kage
# Pelo menos 32 caracteres aleatórios; nunca use este arquivo com valores reais em commits.
SESSION_SECRET=
# Habilite somente se AutoMod/XP precisarem ler conteúdo; exige intent no portal.
ENABLE_MESSAGE_CONTENT=false
# Política inicial, editável por servidor. Não determina obrigação legal.
AUDIT_RETENTION_DAYS=30
TICKET_RETENTION_DAYS=7

# Chave própria para cifrar sessões no servidor; mínimo de 32 caracteres aleatórios.
SESSION_ENCRYPTION_KEY=
# Apenas para preview HTTPS incorporado; SameSite=None; Secure.
EMBEDDED_PREVIEW=false

# Eventos adicionais: habilite explicitamente e configure o portal quando necessário.
ENABLE_GUILD_MEMBERS=false
ENABLE_REACTIONS=false
ENABLE_NATIVE_AUTOMOD_EVENTS=false

# Provedor de IA: contrato /assess próprio; nenhuma chamada ocorre sem aprovação explícita.
AI_PROVIDER_APPROVED=false
AI_PROVIDER_STYLE=contract
AI_PROVIDER_URL=
AI_PROVIDER_ALLOWED_HOSTS=
AI_PROVIDER_TOKEN=
AI_PROVIDER_MODEL=
AI_PROVIDER_REASONING_EFFORT=
AI_PROVIDER_MAX_TOKENS=300
AI_PROVIDER_JSON_MODE=true

# Metadados de mensagens editadas/apagadas (sem habilitar Message Content).
ENABLE_MESSAGE_EVENTS=false
